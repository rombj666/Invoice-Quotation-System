generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id             String      @id @default(cuid())
  name           String
  phone          String
  email          String
  companyName    String?
  companyRegNo   String?
  billingAddress String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  invoices       Invoice[]
  quotations     Quotation[]

  @@index([email])
  @@index([phone])
}

model Quotation {
  id              String           @id @default(cuid())
  quotationNo     String           @unique
  customerId      String
  status          QuotationStatus  @default(DRAFT)
  location        String
  eventType       String
  subtotalAmount  Decimal          @db.Decimal(10, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal          @db.Decimal(10, 2)
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  internalNotes   InternalNote[]
  invoices        Invoice[]
  customer        Customer         @relation(fields: [customerId], references: [id])
  addons          QuotationAddon[]
  dates           QuotationDate[]
  statusHistory   StatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model QuotationDate {
  id                 String              @id @default(cuid())
  quotationId        String
  serviceDate        DateTime
  cups               Int
  serviceStartTime   String
  serviceEndTime     String
  serviceHours       Decimal             @db.Decimal(5, 2)
  baristaCount       Int
  extraBaristaFee    Decimal             @default(0) @db.Decimal(10, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customizationFiles CustomizationFile[]
  quotation          Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  drinks             QuotationDrink[]

  @@index([quotationId])
  @@index([serviceDate])
}

model QuotationDrink {
  id              String        @id @default(cuid())
  quotationDateId String
  drinkId         String
  drinkName       String
  iceCups         Int           @default(0)
  hotCups         Int           @default(0)
  totalCups       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  quotationDate   QuotationDate @relation(fields: [quotationDateId], references: [id], onDelete: Cascade)

  @@index([quotationDateId])
  @@index([drinkId])
}

model QuotationAddon {
  id          String    @id @default(cuid())
  quotationId String
  name        String
  price       Decimal   @default(0) @db.Decimal(10, 2)
  isIncluded  Boolean   @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Invoice {
  id                  String              @id @default(cuid())
  invoiceNo           String              @unique
  quotationId         String
  customerId          String
  status              InvoiceStatus       @default(DRAFT)
  paymentStatus       PaymentStatus       @default(UNPAID)
  eventAddress        String?
  dressCode           String?
  environmentNotes    String?
  finalSubtotalAmount Decimal             @db.Decimal(10, 2)
  finalDiscountAmount Decimal             @default(0) @db.Decimal(10, 2)
  finalTotalAmount    Decimal             @db.Decimal(10, 2)
  invoicePdfUrl       String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  customizationFiles  CustomizationFile[]
  internalNotes       InternalNote[]
  customer            Customer            @relation(fields: [customerId], references: [id])
  quotation           Quotation           @relation(fields: [quotationId], references: [id])
  invoiceFiles        InvoiceFile[]
  items               InvoiceItem[]
  paymentReceipts     PaymentReceipt[]
  statusHistory       StatusHistory[]

  @@index([quotationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  itemType    InvoiceItemType
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType])
}

model PaymentReceipt {
  id                 String        @id @default(cuid())
  invoiceId          String
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  status             PaymentStatus @default(RECEIPT_UPLOADED)
  uploadedAt         DateTime      @default(now())
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

model CustomizationFile {
  id                 String            @id @default(cuid())
  invoiceId          String
  quotationDateId    String?
  type               CustomizationType
  designKey          String
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  metadata           Json?
  createdAt          DateTime          @default(now())
  invoice            Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotationDate      QuotationDate?    @relation(fields: [quotationDateId], references: [id])

  @@index([invoiceId])
  @@index([quotationDateId])
  @@index([type])
  @@index([designKey])
}

model InvoiceFile {
  id                 String   @id @default(cuid())
  invoiceId          String
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  createdAt          DateTime @default(now())
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InternalNote {
  id          String     @id @default(cuid())
  quotationId String?
  invoiceId   String?
  note        String
  createdBy   String
  createdAt   DateTime   @default(now())
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([invoiceId])
}

model StatusHistory {
  id          String     @id @default(cuid())
  quotationId String?
  invoiceId   String?
  fromStatus  String?
  toStatus    String
  changedBy   String
  createdAt   DateTime   @default(now())
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([invoiceId])
  @@index([createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProductAvailability {
  id            String   @id @default(cuid())
  category      String
  itemKey       String   @unique
  itemName      String
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  price         Decimal? @db.Decimal(10, 2)
  pricingConfig Json?
  pricingType   String?

  @@index([category])
  @@index([isAvailable])
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVIEWED
  SENT
  CONVERTED_TO_INVOICE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  PENDING_PAYMENT_REVIEW
  PAID
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  RECEIPT_UPLOADED
  VERIFIED
  REJECTED
}

enum CustomizationType {
  CART_DESIGN
  CUP_STICKER
  CUP_SLEEVE
}

enum InvoiceItemType {
  COFFEE_SERVICE
  EXTRA_BARISTA
  MACHINE_RENTAL
  ADDON
  DISCOUNT
  OTHER
}

enum AdminRole {
  ADMIN
  STAFF
}


