generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVIEWED
  SENT
  CONVERTED_TO_INVOICE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  PENDING_PAYMENT_REVIEW
  PAID
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  RECEIPT_UPLOADED
  VERIFIED
  REJECTED
}

enum CustomizationType {
  CART_DESIGN
  CUP_STICKER
  CUP_SLEEVE
}

enum InvoiceItemType {
  COFFEE_SERVICE
  EXTRA_BARISTA
  EXTRA_SERVING_HOUR
  MACHINE_RENTAL
  ADDON
  DISCOUNT
  OTHER
}

enum DrinkDistributionMode {
  MANUAL
  HOUR_COFFEE_DECIDES
}

enum AdminRole {
  ADMIN
  STAFF
}

enum PackageLevel {
  LOW_SPEC
  MIDDLE_SPEC
  HIGH_SPEC
  CUSTOMIZED
}

model Customer {
  id             String      @id @default(cuid())
  name           String
  phone          String
  email          String
  companyName    String?
  companyRegNo   String?
  billingAddress String
  quotations     Quotation[]
  invoices       Invoice[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([email])
  @@index([phone])
}

model Quotation {
  id                   String                     @id @default(cuid())
  quotationNo          String                     @unique
  customerId           String
  customer             Customer                   @relation(fields: [customerId], references: [id])
  status               QuotationStatus            @default(DRAFT)
  location             String
  eventType            String
  subtotalAmount       Decimal                    @db.Decimal(10, 2)
  discountPercent      Decimal                    @default(0) @db.Decimal(5, 2)
  discountAmount       Decimal                    @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal                    @db.Decimal(10, 2)
  quotationPdfUrl      String?
  quotationPdfPublicId String?
  expiresAt            DateTime?
  metadata             Json?
  dates                QuotationDate[]
  addons               QuotationAddon[]
  extraCharges         QuotationExtraCharge[]
  invoices             Invoice[]
  internalNotes        InternalNote[]
  statusHistory        StatusHistory[]
  analyticsSession     QuotationAnalyticsSession?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model QuotationExtraCharge {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
}

model QuotationDate {
  id                 String                @id @default(cuid())
  quotationId        String
  quotation          Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceDate        DateTime
  cups               Int
  serviceStartTime   String
  serviceEndTime     String
  serviceHours       Decimal               @db.Decimal(5, 2)
  baristaCount       Int
  extraBaristaFee    Decimal               @default(0) @db.Decimal(10, 2)
  distributionMode   DrinkDistributionMode @default(MANUAL)
  drinks             QuotationDrink[]
  customizationFiles CustomizationFile[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([quotationId])
  @@index([serviceDate])
}

model QuotationDrink {
  id                    String        @id @default(cuid())
  quotationDateId       String
  quotationDate         QuotationDate @relation(fields: [quotationDateId], references: [id], onDelete: Cascade)
  drinkId               String
  drinkName             String
  beverageId            String?
  beverage              Beverage?     @relation(fields: [beverageId], references: [id], onDelete: SetNull)
  imageUrlSnapshot      String?
  icedAvailableSnapshot Boolean       @default(true)
  hotAvailableSnapshot  Boolean       @default(false)
  isExcluded            Boolean       @default(false)
  iceCups               Int           @default(0)
  hotCups               Int           @default(0)
  totalCups             Int
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([quotationDateId, beverageId])
  @@index([quotationDateId])
  @@index([drinkId])
  @@index([beverageId])
}

model QuotationAddon {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal   @default(0) @db.Decimal(10, 2)
  isIncluded  Boolean   @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
}

model Invoice {
  id                  String                 @id @default(cuid())
  invoiceNo           String                 @unique
  quotationId         String
  quotation           Quotation              @relation(fields: [quotationId], references: [id])
  customerId          String
  customer            Customer               @relation(fields: [customerId], references: [id])
  status              InvoiceStatus          @default(DRAFT)
  paymentStatus       PaymentStatus          @default(UNPAID)
  eventAddress        String?
  dressCode           String?
  environmentNotes    String?
  finalSubtotalAmount Decimal                @db.Decimal(10, 2)
  finalDiscountAmount Decimal                @default(0) @db.Decimal(10, 2)
  finalTotalAmount    Decimal                @db.Decimal(10, 2)
  invoicePdfUrl       String?
  invoicePdfPublicId  String?
  metadata            Json?
  items               InvoiceItem[]
  paymentReceipts     PaymentReceipt[]
  customizationFiles  CustomizationFile[]
  invoiceFiles        InvoiceFile[]
  internalNotes       InternalNote[]
  statusHistory       StatusHistory[]
  drinkSnapshots      InvoiceDrinkSnapshot[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([quotationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model InvoiceDrinkSnapshot {
  id                    String                @id @default(cuid())
  invoiceId             String
  invoice               Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceDateId         String
  serviceDate           DateTime
  beverageId            String?
  beverageName          String
  imageUrlSnapshot      String?
  icedAvailableSnapshot Boolean               @default(true)
  hotAvailableSnapshot  Boolean               @default(false)
  iceCups               Int                   @default(0)
  hotCups               Int                   @default(0)
  isExcluded            Boolean               @default(false)
  distributionMode      DrinkDistributionMode
  createdAt             DateTime              @default(now())

  @@index([invoiceId])
  @@index([beverageId])
  @@index([serviceDateId])
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    InvoiceItemType
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([invoiceId])
  @@index([itemType])
}

model PaymentReceipt {
  id                 String        @id @default(cuid())
  invoiceId          String
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  status             PaymentStatus @default(RECEIPT_UPLOADED)
  uploadedAt         DateTime      @default(now())

  @@index([invoiceId])
  @@index([status])
}

model CustomizationFile {
  id                 String            @id @default(cuid())
  invoiceId          String
  invoice            Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotationDateId    String?
  quotationDate      QuotationDate?    @relation(fields: [quotationDateId], references: [id])
  type               CustomizationType
  designKey          String
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  metadata           Json?
  createdAt          DateTime          @default(now())

  @@index([invoiceId])
  @@index([quotationDateId])
  @@index([type])
  @@index([designKey])
}

model InvoiceFile {
  id                 String   @id @default(cuid())
  invoiceId          String
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileUrl            String
  cloudinaryPublicId String
  fileName           String
  mimeType           String
  createdAt          DateTime @default(now())

  @@index([invoiceId])
}

model InternalNote {
  id          String     @id @default(cuid())
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  note        String
  createdBy   String
  createdAt   DateTime   @default(now())

  @@index([quotationId])
  @@index([invoiceId])
}

model StatusHistory {
  id            String     @id @default(cuid())
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  changedBy     String
  changeSummary String?
  createdAt     DateTime   @default(now())

  @@index([quotationId])
  @@index([invoiceId])
  @@index([createdAt])
}

model QuotationAnalyticsSession {
  id                 String     @id @default(cuid())
  anonymousSessionId String     @unique
  firstVisitedAt     DateTime   @default(now())
  lastActivityAt     DateTime   @default(now())
  startedAt          DateTime?
  step1EngagedAt      DateTime?
  step2VisitedAt      DateTime?
  packageSelectedAt  DateTime?
  submittedAt        DateTime?
  lastStep           Int?
  quotationId        String?    @unique
  quotation          Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([firstVisitedAt])
  @@index([lastActivityAt])
  @@index([startedAt])
  @@index([submittedAt])
}

model PublicPageVisit {
  id                 String   @id @default(cuid())
  anonymousVisitorId String
  visitDate          DateTime @db.Date
  pagePath           String
  createdAt          DateTime @default(now())

  @@unique([anonymousVisitorId, visitDate, pagePath])
  @@index([visitDate])
  @@index([pagePath])
}

model Beverage {
  id            String           @id @default(cuid())
  legacyKey     String?          @unique
  name          String
  description   String?
  imageUrl      String?
  publicId      String?
  icedAvailable Boolean          @default(true)
  hotAvailable  Boolean          @default(true)
  isAvailable   Boolean          @default(true)
  isArchived    Boolean          @default(false)
  displayOrder  Int              @default(0)
  drinks        QuotationDrink[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isAvailable, isArchived, displayOrder])
  @@index([name])
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProductAvailability {
  id            String   @id @default(cuid())
  category      String
  itemKey       String   @unique
  itemName      String
  isAvailable   Boolean  @default(true)
  pricingType   String?
  price         Decimal? @db.Decimal(10, 2)
  pricingConfig Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isAvailable])
}

model QuotationPackage {
  id               String        @id @default(cuid())
  name             String
  level            PackageLevel  @unique
  briefDescription String?
  price            Decimal       @db.Decimal(10, 2)
  perks            PackagePerk[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([level])
}

model PackagePerk {
  id           String           @id @default(cuid())
  packageId    String
  package      QuotationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([packageId, displayOrder])
}
