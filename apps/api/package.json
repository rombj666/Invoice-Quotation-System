{
  "name": "@hour-coffee/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @hour-coffee/shared",
    "dev": "tsx watch src/node-server.ts",
    "prebuild": "npm run build --workspace @hour-coffee/shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/node-server.js",
    "pretypecheck": "npm run build --workspace @hour-coffee/shared",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/pricing.test.ts tests/drink-selection.test.ts tests/dashboard.test.ts tests/scope-contracts.test.ts"
  },
  "dependencies": {
    "@hour-coffee/shared": "*",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
